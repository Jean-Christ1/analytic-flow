# ============================================================================
# APEX-ML-PLATFORM - Standalone Environment Configuration
# Version: 1.0.0
# Author: Armand AMOUSSOU
# Date: 2026-01-07
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ==========================================================================
# PostgreSQL Configuration
# ==========================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=apex_ml_platform
POSTGRES_PORT=5432

# ==========================================================================
# PgBouncer Configuration
# ==========================================================================
PGBOUNCER_PORT=6432

# ==========================================================================
# MinIO Configuration (S3-Compatible Storage)
# ==========================================================================
MINIO_ROOT_USER=apex_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_MIN_8_CHARS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_URL=http://localhost:9001

# ==========================================================================
# Keycloak Configuration (Optional - use with 'auth' profile)
# ==========================================================================
KEYCLOAK_DB=keycloak
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# ==========================================================================
# pgAdmin Configuration (Optional - use with 'tools' profile)
# ==========================================================================
PGADMIN_EMAIL=admin@apex.local
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# ==========================================================================
# Monitoring Configuration (Optional - use with 'monitoring' profile)
# ==========================================================================
PROMETHEUS_PORT=9090
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3000

# ==========================================================================
# Application Configuration
# ==========================================================================

# Database connection string for the application
# Use pgbouncer for connection pooling in production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${PGBOUNCER_PORT}/${POSTGRES_DB}

# Direct database connection (for migrations and admin tasks)
DATABASE_URL_DIRECT=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT Configuration
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_EXPIRY=24h

# Storage Configuration
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
STORAGE_BUCKET_PREFIX=apex

# Encryption Key (256-bit, hex encoded)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ==========================================================================
# Security Configuration
# ==========================================================================

# SSL Mode for PostgreSQL connections
# Options: disable, allow, prefer, require, verify-ca, verify-full
PGSSLMODE=prefer

# Enable audit logging
AUDIT_ENABLED=true

# Session timeout in seconds (default: 24 hours)
SESSION_TIMEOUT=86400
