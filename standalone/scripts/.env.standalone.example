# ============================================================================
# APEX-ML-PLATFORM - Standalone PostgreSQL Configuration
# ============================================================================
# Copy this file to .env.standalone and fill in your standalone DB credentials
# NEVER commit .env.standalone to version control!
# ============================================================================

# PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=apex_ml_platform

# Use PgBouncer port (6432) for pooled connections in production
# PG_PORT=6432
