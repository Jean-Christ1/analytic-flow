# ============================================================================
# APEX-ML-PLATFORM - Supabase Export Configuration
# ============================================================================
# Copy this file to .env.supabase and fill in your Supabase credentials
# NEVER commit .env.supabase to version control!
# ============================================================================

# Supabase project reference (from Supabase dashboard URL)
# Example: if your URL is https://rwqzweqrfiucqokghgjg.supabase.co
# then your project ref is: rwqzweqrfiucqokghgjg
SUPABASE_PROJECT_REF=your_project_ref_here

# Database password (from Supabase dashboard > Settings > Database)
SUPABASE_DB_PASSWORD=your_database_password_here
